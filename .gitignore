# ---------- Dependencies ----------
node_modules/
.venv/
venv/
env/

# ---------- Build output ----------
frontend/build/
frontend/.cache/
*.tsbuildinfo

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

