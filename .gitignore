backend/uploads/*
backend/reports/*
!backend/uploads/.gitkeep
!backend/reports/.gitkeep
backend/security/logs/*
backend/ml/*.json

# ---------- Logs / OS ----------
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ---------- IDE ----------
.idea/
.vscode/
