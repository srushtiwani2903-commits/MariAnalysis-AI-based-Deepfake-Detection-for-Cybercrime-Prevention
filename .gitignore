# ---------- Dependencies ----------
node_modules/
.venv/
venv/
env/

# ---------- Build output ----------
frontend/build/
frontend/.cache/
*.tsbuildinfo

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---------- Environment & secrets (never commit!) ----------
.env
.env.local
.env.*.local
*.pem
*.key

# ---------- Runtime data ----------
backend/instance/
backend/deepfake.db
backend/uploads/*
backend/reports/*
!backend/uploads/.gitkeep
!backend/reports/.gitkeep
backend/security/logs/*
# Encrypted secret vault + its master key + bootstrap note (never commit!)
backend/security/secrets.vault
backend/security/master.key
backend/security/ADMIN_CREDENTIALS.txt
backend/ml/*.json
# Trained model weights (reproducible from Kaggle; only the deployed model is tracked)
backend/models/*.pt
backend/models/*.pth
backend/models/*.onnx
!backend/models/faces_real_vs_fake_cnn.pt
!backend/models/.gitkeep

# ---------- Logs / OS ----------
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ---------- IDE ----------
.idea/
.vscode/

# BROWSER=none is not a secret - intentionally tracked so npm start never opens tabs
!frontend/.env
