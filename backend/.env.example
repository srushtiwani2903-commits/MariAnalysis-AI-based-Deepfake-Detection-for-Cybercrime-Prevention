# ---- MariAnalysis backend environment ----
# Copy to .env and adjust. Never commit the real .env.
#
# SECRETS AND PASSWORDS ARE NOT READ FROM .env ANYMORE. They live in an
# encrypted vault (backend/security/secrets.vault) guarded by a master key.
# On first boot the vault auto-creates itself and migrates any values you
# already have in .env (SECRET_KEY, JWT_SECRET_KEY, KAGGLE_*, GEMINI_API_KEY,
# MSG91_AUTHKEY, SMTP_PASSWORD, ADMIN_PASSWORD). After migration you can
# remove them from .env.
#
# Master key for the vault: set here, or let the app generate
# backend/security/master.key on first boot (also fine).
SECRETS_MASTER_KEY=

# JWT expiry + cookie hardening (web sessions ride an HttpOnly cookie).
JWT_EXPIRES_HOURS=2
# Set false when accessing the API over plain http from a LAN IP.
# localhost is always treated as secure, so leave true for dev.
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Strict
FLASK_DEBUG=false

# sqlite (default) or mysql:
#   DATABASE_URL=mysql+pymysql://user:pass@localhost/marianalysis
DATABASE_URL=sqlite:///deepfake.db

# Per-media-type upload caps (in MB). Flask's global request-body cap is
# automatically set to the largest of these (20 GB).
IMAGE_MAX_MB=1024
VIDEO_MAX_MB=20480
TEXT_MAX_MB=20480
AUDIO_MAX_MB=10240

# The app runs on explainable heuristic engines that need no model weights.
# Set MODEL_ENABLED=true after training ml/train_cnn_kaggle.py and copying
# marianalysis_cnn.pt to backend/models/faces_real_vs_fake_cnn.pt - the image
# detector then blends the real CNN into every image verdict.
MODEL_ENABLED=false
# Path to the trained image CNN checkpoint (see backend/models/).
# IMAGE_CNN_PATH=backend/models/faces_real_vs_fake_cnn.pt
# 0..1 blend weight between the CNN and the heuristic engines for images.
# IMAGE_CNN_WEIGHT=0.45

# ---- Real AI providers (Hybrid engine) ----
# Get a free Gemini API key at https://aistudio.google.com/app/apikey
# (no credit card). gemini-2.5-flash: ~250 free requests/day,
# gemini-2.5-flash-lite: ~1000 free requests/day (slower/budget model).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=20
# Local Hugging Face transformers (offline, free, unlimited) for image + text.
# First scan downloads weights to the HF cache (~500 MB). Set false to disable.
LOCAL_MODELS_ENABLED=true
# Final verdict blend: 0.35*heuristic + 0.40*gemini + 0.25*local (re-normalised
# when a provider is unavailable - heuristics always remain the fallback).
AI_BLEND_HEURISTIC=0.35
AI_BLEND_GEMINI=0.40
AI_BLEND_LOCAL=0.25

# ---- Kaggle on-demand data pipeline ----
# Credentials are read from the encrypted vault (migrated from .env on first
# boot), not from this file. Datasets are fetched directly from Kaggle by
# ml/kaggle_pipeline.py ONLY when needed, extracted to a temp cache, used,
# then the temp cache is auto-deleted - nothing is stored in the project.
# KAGGLE_USERNAME / KAGGLE_KEY live in backend/security/secrets.vault
# KAGGLE_JSON_PATH=C:\Users\you\.kaggle\kaggle.json   # optional alternative
KAGGLE_AUTOSYNC=false
KAGGLE_FORCE=false

# Live-scan "reference comparison" for images: on the first scan a small sample
# of real + fake images is pulled directly from Kaggle into a temp cache
# (auto-deleted), per-class feature distributions are built in-process, and
# every later scan (Live Webcam / URL / browser extension) is scored against
# them, blending 25% into the heuristic verdict. Set false to disable.
KAGGLE_REFERENCE_ENABLED=true
KAGGLE_REFERENCE_SAMPLE_SIZE=10

# ---- Cloud model training (Kaggle GPU notebooks, no local dataset) ----
# Training runs entirely on Kaggle's cloud GPU. The app pushes a notebook via
# the Kaggle API, the dataset is mounted on Kaggle's machine, and only the
# trained weights are pulled back into backend/models/<media>/. Start via the
# admin API:  POST /api/model/train {"media":"image"}
# Requires the kaggle client:  pip install -r requirements.txt -r requirements-ai.txt
KAGGLE_TRAIN_POLL_SECONDS=45
KAGGLE_TRAIN_MAX_HOURS=6

# Optional extra datasets (comma-separated slugs) merged into the image set:
# KAGGLE_EXTRA_DATASETS=user/dataset1,user/dataset2

# Fetch + extract a dataset directly from Kaggle to the temp cache:
#   python -m ml.kaggle_pipeline --image

CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Intrusion Detection & Prevention (fail2ban-style IP lockout on login)
IDPS_ENABLED=true
IDPS_MAX_FAILED_ATTEMPTS=5
IDPS_WINDOW_SECONDS=600
IDPS_BAN_SECONDS=900

# Bootstrap admin account (created on first start). ADMIN_PASSWORD is read from
# the encrypted vault - set it here once so the first boot migrates it in, or
# leave blank and a random password is generated + printed on first boot.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@marianalysis.local
# ADMIN_PASSWORD=YourStrongPass1!

# ---- E-mail (password reset links) ----
# Set MAIL_ENABLED=true and fill SMTP creds to actually send reset emails
# (e.g. Gmail: host smtp.gmail.com, port 587, your Gmail app password).
# SMTP creds are read from the encrypted vault (migrated from .env on first
# boot). When MAIL_ENABLED=false, reset links are logged to
# security/logs/reset_links.log for dev.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
MAIL_FROM=MariAnalysis <no-reply@marianalysis.local>
MAIL_STARTTLS=true
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_TTL_HOURS=1

# ---- OTP verification (email + phone) ----
# Phone OTPs go through MSG91 when MSG91_AUTHKEY + MSG91_TEMPLATE_ID are set.
# Without them the OTP is logged to security/logs/otp_phone.log and, with
# DEBUG_OTP=true, shown on the verify screen (dev mode).
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# DEBUG_OTP=true returns the OTP in API responses so the flow works without a
# real SMS provider. Set false in production.
DEBUG_OTP=true

# ---- AI assistant (Gemini) ----
# GEMINI_API_KEY is read from the encrypted vault (migrated from .env on first
# boot). Set it to make the /api/chat assistant answer ANY question (like
# ChatGPT). Without a key the chatbot uses the built-in rule-based replies.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=25
GEMINI_MAX_OUTPUT_TOKENS=1024

# ---- MSG91 SMS (India) ----
# MSG91_AUTHKEY is read from the encrypted vault (migrated from .env on first
# boot). From the MSG91 dashboard: Auth Key (Settings > API Keys), and an
# approved OTP template (Settings > Templates) gives the Template ID + 6-char
# Sender ID.
MSG91_SENDER_ID=MARIIN
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91
