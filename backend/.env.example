# ---- MariAnalysis backend environment ----
# Copy to .env and adjust. Never commit the real .env.

SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_EXPIRES_HOURS=2
FLASK_DEBUG=false

# sqlite (default) or mysql:
#   DATABASE_URL=mysql+pymysql://user:pass@localhost/marianalysis
DATABASE_URL=sqlite:///deepfake.db

MAX_UPLOAD_MB=50

# The app runs on heuristic engines that need no model weights. Real-model
# training was removed; this flag exists only for display/compat.
MODEL_ENABLED=false

# ---- Kaggle on-demand data pipeline ----
# Get an API key at https://www.kaggle.com/settings -> API. Datasets are fetched
# directly from Kaggle by ml/kaggle_pipeline.py ONLY when needed, extracted to a
# temp cache, used, then the temp cache is auto-deleted - nothing is stored in
# the project. No model training happens.
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key
# KAGGLE_JSON_PATH=C:\Users\you\.kaggle\kaggle.json   # optional alternative to above
KAGGLE_AUTOSYNC=false
KAGGLE_FORCE=false
# Optional extra datasets (comma-separated slugs) merged into the image set:
# KAGGLE_EXTRA_DATASETS=user/dataset1,user/dataset2

# Fetch + extract a dataset directly from Kaggle to the temp cache:
#   python -m ml.kaggle_pipeline --image

CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Intrusion Detection & Prevention (fail2ban-style IP lockout on login)
IDPS_ENABLED=true
IDPS_MAX_FAILED_ATTEMPTS=5
IDPS_WINDOW_SECONDS=600
IDPS_BAN_SECONDS=900

# Bootstrap admin account (created on first start)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@marianalysis.local
ADMIN_PASSWORD=Admin@12345

# ---- E-mail (password reset links) ----
# Set MAIL_ENABLED=true and fill SMTP creds to actually send reset emails
# (e.g. Gmail: host smtp.gmail.com, port 587, your Gmail app password).
# When false, reset links are logged to security/logs/reset_links.log for dev.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MariAnalysis <no-reply@marianalysis.local>
MAIL_STARTTLS=true
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_TTL_HOURS=1

# ---- OTP verification (email + phone) ----
# Phone OTPs go through MSG91 when MSG91_AUTHKEY + MSG91_TEMPLATE_ID are set.
# Without them the OTP is logged to security/logs/otp_phone.log and, with
# DEBUG_OTP=true, shown on the verify screen (dev mode).
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# DEBUG_OTP=true returns the OTP in API responses so the flow works without a
# real SMS provider. Set false in production.
DEBUG_OTP=true

# ---- MSG91 SMS (India) ----
# From MSG91 dashboard: Auth Key (Settings > API Keys), and an approved OTP
# template (Settings > Templates) gives the Template ID + 6-char Sender ID.
MSG91_AUTHKEY=
MSG91_SENDER_ID=MARIIN
MSG91_TEMPLATE_ID=
MSG91_COUNTRY_CODE=91
